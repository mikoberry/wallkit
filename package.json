{
  "name": "wallkit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable control overlays for Wallpaper Engine web wallpapers",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./components": "./src/components/index.js",
    "./components/clock": "./src/components/clock/index.js",
    "./components/spectrum": "./src/components/spectrum/index.js",
    "./components/mini-spectrum": "./src/components/mini-spectrum/index.js",
    "./components/album-art": "./src/components/album-art/index.js",
    "./components/pointer-fx": "./src/components/pointer-fx/index.js",
    "./components/ambient-fx": "./src/components/ambient-fx/index.js",
    "./we": "./src/we/index.js",
    "./we/vite": "./src/we/vite-plugin.js",
