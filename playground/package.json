{
  "name": "wallkit-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:wallpaper": "vite build --config vite.wallpaper.config.js",
    "gen:project": "node scripts/gen-project.mjs",
    "check:project": "node scripts/gen-project.mjs --check",
    "test:project": "node scripts/test-project.mjs",
    "deploy:wallpaper": "npm run build:wallpaper && node scripts/deploy-wallpaper.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
